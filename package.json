{
  "name": "telno-platform",
  "private": true,
  "version": "2026.1.0",
  "description": "Telno T750 / HT802 platform: control plane, provisioning and cantus voice control.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace @telno/server",
    "dev:console": "npm run dev --workspace @telno/console",
    "build": "npm run build --workspace @telno/console && npm run build --workspace @telno/server",
    "start": "npm run start --workspace @telno/server",
    "proxy": "node scripts/proxy.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @telno/server"
  }
}
