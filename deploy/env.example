# Telno — the settings a fresh install is asked for.
#
# The installer copies this to .env beside docker-compose.yml; edit it there and
# restart with `docker compose up -d`. Everything not named here has a default in
# the application, including the session secret, API-key pepper and AMI password,
# which are generated on first boot and kept on the data volume.
#
# Secrets (Stripe, mail, VoIP.ms, Apple push) belong in Settings → Vault in the
# console once it is running, not in this file.

# The address browsers use. A real hostname needs TLS in front of it; the platform
# refuses to boot in production with an http public URL on a real hostname,
# because session cookies are marked secure.
PUBLIC_URL=http://localhost:8080

# The owner account. ADMIN_PASSWORD may stay empty: first boot generates one and
# writes it to the data volume, where `docker compose exec telno cat
# /data/first-run-password.txt` reads it.
ADMIN_EMAIL=admin@telno.local
ADMIN_PASSWORD=

DEFAULT_COUNTRY=US

# Optional TURN relay for hard NATs. Without it, calls still work on ordinary NATs.
TURN_URLS=
TURN_SECRET=
