# --- Telno control plane -----------------------------------------------------
# This file is authoritative for the keys it defines: an exported PORT in your
# shell will not override the values here. Empty values are ignored.
PORT=8787
HOST=127.0.0.1

# TLS terminator (npm run proxy → Caddy). Certificates come from Caddy's
# internal CA, trusted on first start, so browsers show no warning.
TLS_PORT=8443
# Site addresses Caddy answers on. Only names with a certificate answer at all.
# TLS_ADDRESSES=https://192.168.1.17:8443, https://localhost:8443

# Plain-HTTP listener that serves device provisioning (/prov) and nothing else,
# for firmware that cannot trust a private CA. Only private ranges may reach it.
PROVISION_PORT=8088

# First-run admin, applied only when the database has no users yet.
# Set a real password here before the first boot; nothing is shipped with one.
TELNO_ADMIN_USER=admin
TELNO_ADMIN_PASSWORD=change-me-before-first-run

# SQLite file. Created on first boot.
TELNO_DB=.data/telno.db

# Sessions are marked Secure when NODE_ENV=production. Set this to 1 only when
# you are deliberately serving plain HTTP on loopback during a local trial.
# TELNO_INSECURE_COOKIES=1

# Key used to sign device configuration. Generated and stored on first boot
# when unset; set it to keep signatures stable across a fresh database.
# TELNO_PROVISIONING_KEY=

# Console allowlist: comma-separated CIDRs allowed to sign in to, or call, the
# console API. Devices are unaffected — /prov authenticates with tokens.
# Defaults to loopback plus RFC 1918 when unset.
# NOTE: this seeds the saved setting on first boot; after that, Settings owns the
# value. If the two differ at startup the server warns about it.
# TELNO_TRUSTED_NETWORKS=127.0.0.1/32,::1/128,192.168.1.0/24

# Directory holding the cantus checkout (bin/cantus + lib/). The reference
# stack is vendored at ./vendor/cantus.
TELNO_CANTUS_DIR=vendor/cantus
TELNO_PERL=perl

# Voice node announced to devices. cantus uses one UDP port for signalling
# and media; 7443 is the standard port.
TELNO_VOICE_NODE=
TELNO_VOICE_PORT=7443
TELNO_VOICE_RELAY=
